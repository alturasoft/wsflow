# ==========================================
# ENTORNO Y PUERTOS
# ==========================================
NODE_ENV=development
PORT=3000
FRONTEND_PORT=3001

# ==========================================
# POSTGRESQL (MULTI-TENANT DB)
# ==========================================
POSTGRES_USER=wsflow_user
POSTGRES_PASSWORD=wsflow_secure_password_2026
POSTGRES_DB=wsflow_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_DB}?schema=public

# Para ejecución dentro de contenedores docker:
# DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}?schema=public

# ==========================================
# REDIS (SESIONES Y COLAS BULLMQ)
# ==========================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ==========================================
# SEGURIDAD Y JWT
# ==========================================
JWT_SECRET=super_secret_jwt_key_wsflow_tenant_2026_change_in_production
JWT_EXPIRES_IN=7d
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef # 32 bytes hex para AES-256

# ==========================================
# META WHATSAPP CLOUD API (CONFIGURACIÓN GLOBAL / FALLBACK)
# ==========================================
META_API_VERSION=v20.0
META_WEBHOOK_VERIFY_TOKEN=wsflow_webhook_verify_token_secure_2026
META_APP_SECRET=your_meta_app_secret_here

# ==========================================
# MOTOR RAG Y BASE DE DATOS VECTORIAL (QDRANT)
# ==========================================
QDRANT_URL=http://localhost:6333
# Proveedores de Embeddings e IA Generativa (al menos uno requerido para RAG)
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
