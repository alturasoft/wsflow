# ==========================================
# WSFlow - Reglas de Exclusión Git
# ==========================================

# Dependencias (muy pesadas para Git)
node_modules/
backend/node_modules/
frontend/node_modules/

# Archivos de entorno y credenciales sensibles (¡NUNCA subir a Git!)
.env
.env.production
.env.local
backend/.env
frontend/.env
!.env.example

# Carpetas de compilación
backend/dist/
frontend/dist/
dist/

# Logs del sistema
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Archivos temporales de agentes y desarrollo
.agents/
scratch/
*.tar.gz

# Archivos de editores y sistemas operativos
.vscode/
.idea/
.DS_Store
Thumbs.db
